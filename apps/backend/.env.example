# For local development only. In production use a strong JWT_SECRET, SSL database URL,
# explicit ALLOWED_ORIGINS, and set SUPERADMIN_PASSWORD for the seeded admin account.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slotcare?schema=public"
PORT=4000
JWT_SECRET="change-me"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4000"
WEB_DIST_PATH=""
AI_PROVIDER=groq
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=""
NOTIFICATION_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
WHATSAPP_VERIFY_TOKEN="slotcare-webhook-verify"
META_APP_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SUPERADMIN_PASSWORD="Password123"
