[Unit]
Description=Slotcare Booking App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/oppoint_booking
ExecStart=/usr/bin/node /var/www/oppoint_booking/apps/backend/dist/index.js
Restart=on-failure
Environment=NODE_ENV=production
Environment=PORT=4000

[Install]
WantedBy=multi-user.target
